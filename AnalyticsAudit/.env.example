# ---------------------------------------------------------------------------
# Static app configuration
# These values come from the Meta App Dashboard and rarely change.
# App Dashboard -> App settings -> Basic
# ---------------------------------------------------------------------------

META_APP_ID=
META_APP_SECRET=

# Configuration reference (not used at runtime, kept for documentation)
META_CONFIG_ID=

# ---------------------------------------------------------------------------
# Resource IDs
# Public identifiers for the Facebook Page and linked Instagram Business
# Account. Kept here for the bootstrap client (rmon.dev); additional clients
# are stored in the SQLite `clients` table via `npm run client:add`.
# ---------------------------------------------------------------------------

META_PAGE_ID=
META_INSTAGRAM_BUSINESS_ACCT_ID=

# ---------------------------------------------------------------------------
# Runtime-minted secret
# The Page Access Token is generated manually and expires (long-lived tokens
# last ~60 days). When it expires, mint a new one:
#   1. Open https://developers.facebook.com/tools/explorer
#   2. Select the `rmondev-analytics-tester` app
#   3. Issue: GET me/accounts
#   4. Copy the `access_token` value from the target Page object
#   5. Paste it into .env.local (never commit it)
# ---------------------------------------------------------------------------

META_PAGE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# TikTok Developer credentials
# Created at https://developers.tiktok.com -> Manage apps -> app detail page.
# See docs/TIKTOK_SETUP.md for the full portal walkthrough.
#
# Client Key starts with `aw...`; Client Secret is a long opaque string.
# Treat both like passwords — .env.local is gitignored.
# ---------------------------------------------------------------------------

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional override. The TikTok app's Login Kit must have this exact URI
# registered as a redirect target (any mismatch fails OAuth). Default is
# baked into the audit code; only set this if you need a non-standard port.
# TIKTOK_REDIRECT_URI=http://localhost:3001/oauth/tiktok/callback
